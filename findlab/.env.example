# Anthropic API key (server-side only). Leave empty to run in demo mode with precomputed AI responses.
ANTHROPIC_API_KEY=
# Model to use for all AI features
CLAUDE_MODEL=claude-sonnet-5-5
# Set to 1 to force demo mode (precomputed AI responses) — handy if the venue Wi-Fi is flaky
FINDLAB_DEMO_MODE=0
