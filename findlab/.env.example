# Anthropic API key (server-side only). Leave empty to run with non-AI fallbacks (demo mode).
ANTHROPIC_API_KEY=
# Model for all AI features
CLAUDE_MODEL=claude-sonnet-5-5
# Max AI requests per user (IP) per hour — protects your API key
AI_RATE_LIMIT_PER_HOUR=30
# Contact shown in the crawler's User-Agent
TEAM_EMAIL=
# Set to 1 to force demo mode (no AI calls), e.g. on flaky Wi-Fi
FINDLAB_DEMO_MODE=0
